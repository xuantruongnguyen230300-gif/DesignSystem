{
  "component": {
    "{{name}}": {
      "height": { "$type": "dimension", "$value": "{semantic.size.control.md}", "$description": "Default block size (density-aware)." },
      "height-sm": { "$type": "dimension", "$value": "{semantic.size.control.sm}", "$description": "Small block size." },
      "height-lg": { "$type": "dimension", "$value": "{semantic.size.control.lg}", "$description": "Large block size." },
      "padding-inline": { "$type": "dimension", "$value": "{semantic.space.inset.md}", "$description": "Horizontal padding." },
      "gap": { "$type": "dimension", "$value": "{semantic.space.gap.sm}", "$description": "Gap between icon and label." },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}", "$description": "Corner radius." },
      "font": { "$type": "typography", "$value": "{semantic.typography.label-md}", "$description": "Label typography." },
      "text": { "$type": "color", "$value": "{semantic.color.text.default}", "$description": "Label color, rest." },
      "text-disabled": { "$type": "color", "$value": "{semantic.color.text.disabled}", "$description": "Label color, disabled." },
      "bg": { "$type": "color", "$value": "{semantic.color.bg.surface}", "$description": "Background, rest." },
      "bg-hover": { "$type": "color", "$value": "{semantic.color.bg.surface-hover}", "$description": "Background, hover." },
      "bg-disabled": { "$type": "color", "$value": "{semantic.color.bg.disabled}", "$description": "Background, disabled." }
    }
  }
}
