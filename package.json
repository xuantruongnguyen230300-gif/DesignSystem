{
  "name": "nxt-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NXT Design — multi-product design system (Angular 21 + CDK, W3C DTCG tokens)",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node tools/docs/dev.mjs",
    "build": "npm run tokens:build && npm run docs:generate && ng build ui && ng build docs",
    "test": "node tools/test/unit.mjs",
    "test:a11y": "playwright test",
    "tokens:build": "node tools/tokens/build.mjs",
    "tokens:palettes": "node tools/tokens/palette.mjs --config packages/tokens/palettes.json",
    "docs:generate": "node tools/docs/generate.mjs",
    "ds:tokens": "node tools/tokens/validate.mjs",
    "ds:hardcoded": "node tools/lint/check-hardcoded.mjs",
    "ds:check": "node tools/tokens/validate.mjs && node tools/lint/check-hardcoded.mjs",
    "ds:palette": "node tools/tokens/palette.mjs",
    "ds:contrast": "node tools/tokens/contrast.mjs",
    "ds:new": "node tools/scaffold/component.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "jsdom": "^28.0.0",
    "marked": "^18.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
