{
  "name": "@nxt/tokens",
  "version": "0.1.0",
  "description": "NXT Design tokens — W3C DTCG source, CSS custom properties per mode/brand, SCSS breakpoints, JS constants",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "src", "tokens.config.json"],
  "exports": {
    "./css/*": "./dist/css/*",
    "./scss/*": "./dist/scss/*",
    "./json/tokens.json": "./dist/json/tokens.json",
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    }
  }
}
