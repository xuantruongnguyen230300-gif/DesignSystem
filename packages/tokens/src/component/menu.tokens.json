{
  "component": {
    "menu": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.bg.surface-raised}",
        "$description": "Nền menu nổi."
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.default}",
        "$description": "Viền menu."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.overlay}",
        "$description": "Bo góc menu."
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.space.inset.sm}",
        "$description": "Đệm panel, đủ rộng để mục bo 14px lồng đều trong panel bo 32px."
      },
      "item-radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}",
        "$description": "Bo góc mục menu."
      },
      "item-padding-inline": {
        "$type": "dimension",
        "$value": "{semantic.space.inset.md}",
        "$description": "Padding ngang mục và nhãn nhóm."
      },
      "item-text": {
        "$type": "color",
        "$value": "{semantic.color.text.default}",
        "$description": "Chữ mục menu."
      },
      "item-bg-hover": {
        "$type": "color",
        "$value": "{semantic.color.bg.selected}",
        "$description": "Nền mục khi hover/focus (nền nhạt tông accent như mục đang chọn của mockup; bg.surface-hover trùng nền menu ở dark nên không dùng được)."
      },
      "item-danger-text": {
        "$type": "color",
        "$value": "{semantic.color.text.danger}",
        "$description": "Chữ mục phá huỷ."
      },
      "item-height": {
        "$type": "dimension",
        "$value": "{semantic.size.control.md}",
        "$description": "Chiều cao mục."
      },
      "label-text": {
        "$type": "color",
        "$value": "{semantic.color.text.subtle}",
        "$description": "Chữ nhãn nhóm trong menu."
      },
      "min-width": {
        "$type": "dimension",
        "$value": "{semantic.layout.item-min-sm}",
        "$description": "Bề rộng tối thiểu."
      }
    }
  }
}
