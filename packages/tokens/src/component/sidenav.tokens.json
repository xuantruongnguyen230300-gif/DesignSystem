{
  "component": {
    "sidenav": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.bg.transparent}",
        "$description": "Nền thanh điều hướng: trong suốt, nằm thẳng trên nền ứng dụng (phẳng như HeroUI)."
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.subtle}",
        "$description": "Đường kẻ mảnh trong sidenav (chân, vạch ngăn nhóm ở rail); viền ngoài chỉ dùng khi forced-colors."
      },
      "width": {
        "$type": "dimension",
        "$value": "{semantic.layout.sidebar-width}",
        "$description": "Bề rộng khi mở."
      },
      "width-collapsed": {
        "$type": "dimension",
        "$value": "{semantic.layout.sidebar-width-collapsed}",
        "$description": "Bề rộng khi thu gọn (chỉ icon)."
      },
      "item-height": {
        "$type": "dimension",
        "$value": "{semantic.size.control.lg}",
        "$description": "Chiều cao mục cấp 1."
      },
      "subitem-height": {
        "$type": "dimension",
        "$value": "{semantic.size.control.md}",
        "$description": "Chiều cao mục con."
      },
      "item-radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}",
        "$description": "Bo góc mục."
      },
      "item-text": {
        "$type": "color",
        "$value": "{semantic.color.text.default}",
        "$description": "Chữ mục."
      },
      "item-icon": {
        "$type": "color",
        "$value": "{semantic.color.icon.subtle}",
        "$description": "Icon mục."
      },
      "item-bg-hover": {
        "$type": "color",
        "$value": "{semantic.color.bg.surface-hover}",
        "$description": "Nền mục khi hover."
      },
      "item-active-bg": {
        "$type": "color",
        "$value": "{semantic.color.bg.primary-subtle}",
        "$description": "Skin iOS: mục active tô accent nhạt."
      },
      "item-active-text": {
        "$type": "color",
        "$value": "{semantic.color.text.link}",
        "$description": "Chữ accent."
      },
      "item-active-icon": {
        "$type": "color",
        "$value": "{semantic.color.icon.primary}",
        "$description": "Icon accent."
      },
      "indicator": {
        "$type": "color",
        "$value": "{semantic.color.border.selected}",
        "$description": "Vạch chỉ báo mục con đang active trên đường dẫn phân cấp."
      },
      "guide": {
        "$type": "color",
        "$value": "{semantic.color.border.default}",
        "$description": "Đường dẫn phân cấp nối các mục con."
      },
      "heading-text": {
        "$type": "color",
        "$value": "{semantic.color.text.subtle}",
        "$description": "Chữ tiêu đề nhóm."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.container}",
        "$description": "Bo góc card sidenav (kiểu C: sidenav là một card nổi)."
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{semantic.elevation.none}",
        "$description": "Sidenav phẳng, không bóng."
      },
      "shadow-drawer": {
        "$type": "shadow",
        "$value": "{semantic.elevation.modal}",
        "$description": "Bóng của sidenav khi mở như drawer trên màn hình hẹp."
      }
    }
  }
}
