      },
      "height": {
        "$type": "dimension",
        "$value": "{semantic.size.control.md}",
        "$description": "Chiều cao cỡ md (theo density)."
      },
      "height-sm": {
        "$type": "dimension",
        "$value": "{semantic.size.control.sm}",
        "$description": "Chiều cao cỡ sm."
