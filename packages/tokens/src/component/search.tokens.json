{
  "component": {
    "search": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.bg.muted}",
        "$description": "Nền ô tìm kiếm: đặc, hơi xám (kiểu iOS); ranh giới 1px vẫn đạt 3:1."
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.color.text.strong}",
        "$description": "Chữ đang gõ."
      },
      "placeholder": {
        "$type": "color",
        "$value": "{semantic.color.text.subtle}",
        "$description": "Gợi ý khi ô trống."
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border.input}",
        "$description": "Viền ô (≥ 3:1 với nền)."
      },
      "border-hover": {
        "$type": "color",
        "$value": "{semantic.color.border.input-hover}",
        "$description": "Viền khi hover."
      },
      "border-focus": {
        "$type": "color",
        "$value": "{semantic.color.border.selected}",
