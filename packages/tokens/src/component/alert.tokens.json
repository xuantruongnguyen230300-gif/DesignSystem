      },
      "icon-warning": {
        "$type": "color",
        "$value": "{semantic.color.icon.warning}",
        "$description": "Icon alert warning."
      },
      "icon-danger": {
        "$type": "color",
        "$value": "{semantic.color.icon.danger}",
