{
  "primitive": {
    "duration": {
      "$type": "duration",
      "0": { "$value": "0ms" },
      "100": { "$value": "100ms" },
      "150": { "$value": "150ms" },
      "200": { "$value": "200ms" },
      "300": { "$value": "300ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] }
    }
  }
}
