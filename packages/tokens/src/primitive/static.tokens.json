{
  "primitive": {
    "color": {
      "$type": "color",
      "white": {
        "$value": "#FFFFFF"
      },
      "black": {
        "$value": "#000000"
      },
      "transparent": {
        "$value": "#00000000"
      },
      "scrim": {
        "light": {
          "$value": "#090A0C73",
          "$description": "Modal backdrop on light UI (45%)."
        },
        "dark": {
          "$value": "#000000A6",
          "$description": "Modal backdrop on dark UI (65%)."
        }
      }
    },
    "shadow": {
      "1": {
        "$value": [
          {
            "color": "#090A0C0F",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          }
        ]
      },
      "2": {
        "$value": [
          {
            "color": "#141E3C0A",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          },
          {
            "color": "#141E3C0F",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "14px",
            "spread": "0px"
          }
        ],
        "$description": "Bóng nhẹ hai lớp: card, menu, popover, tooltip (mỏng hơn kiểu C ban đầu, theo HeroUI)."
      },
      "3": {
        "$value": [
          {
            "color": "#141E3C3D",
            "offsetX": "0px",
            "offsetY": "24px",
            "blur": "64px",
            "spread": "0px"
          }
        ],
        "$description": "Bóng lớp phủ lớn: dialog, drawer (kiểu C)."
      },
      "$type": "shadow",
      "dark-1": {
        "$value": [
          {
            "color": "#00000066",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          }
        ]
      },
      "dark-2": {
        "$value": [
          {
            "color": "#00000059",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          },
          {
            "color": "#00000073",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "14px",
            "spread": "0px"
          }
        ],
        "$description": "Bản tối của shadow.2."
      },
      "dark-3": {
        "$value": [
          {
            "color": "#000000B3",
            "offsetX": "0px",
            "offsetY": "24px",
            "blur": "64px",
            "spread": "0px"
          }
        ],
        "$description": "Bản tối của shadow.3."
      },
      "none": {
        "$value": [
          {
            "color": "#00000000",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          }
        ],
        "$description": "Không bóng (giữ chỗ cho token shadow)."
      },
      "surface": {
        "$value": [
          {
            "color": "#0000000A",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px"
          },
          {
            "color": "#0000000F",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          },
          {
            "color": "#0000000F",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "1px",
            "spread": "0px"
          }
