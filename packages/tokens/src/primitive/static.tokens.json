        "$value": [
          {
            "color": "#00000066",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px"
          },
          {
            "color": "#00000080",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          },
          {
            "color": "#00000080",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "1px",
            "spread": "0px"
          }
        ],
        "$description": "Bản tối của shadow.surface."
      }
    }
