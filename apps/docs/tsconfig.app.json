{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "paths": {
      "@nxt/ui": [
        "../../packages/ui/src/public-api.ts"
      ],
      "@nxt/ui/*": [
        "../../packages/ui/*/public-api.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
